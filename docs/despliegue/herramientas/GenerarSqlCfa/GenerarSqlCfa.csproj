<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.20" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the original schema sources without building or starting the API. -->
    <Compile Include="../../../../backend/ControlFinanciero.API/ControlFinanciero.API/Data/ApplicationDbContext.cs" Link="Original/ApplicationDbContext.cs" />
    <Compile Include="../../../../backend/ControlFinanciero.API/ControlFinanciero.API/Models/*.cs" Link="Original/Models/%(Filename)%(Extension)" />
    <Compile Include="../../../../backend/ControlFinanciero.API/ControlFinanciero.API/Migrations/*.cs" Link="Original/Migrations/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
